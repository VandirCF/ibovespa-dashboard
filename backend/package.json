{
  "name": "ibovespa-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "coleta:disparar": "ts-node scripts/triggerColeta.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^8.55.2",
    "axios": "^1.21.0",
    "bullmq": "^4.18.3",
    "cheerio": "^1.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^4.29.1",
    "ioredis": "^5.11.1",
    "pino": "^8.21.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "yahoo-finance2": "^2.14.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ioredis-mock": "^8.13.1",
    "prettier": "^3.9.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  }
}
