# Copie para backend/.env e preencha. NUNCA commite valores reais.
DATABASE_URL="postgresql://ibovespa:ibovespa@localhost:5432/ibovespa"
REDIS_URL=redis://localhost:6379
BRAPI_TOKEN=            # Token da brapi.dev (sem ele, a brapi atende só alguns tickers)
NODE_ENV=development
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_API_KEY=            # Chave do painel /admin/jobs/status (use um valor longo e aleatório)
# Monitoramento (opcional: sem DSN o Sentry fica desligado)
SENTRY_DSN=
SENTRY_RELEASE=
